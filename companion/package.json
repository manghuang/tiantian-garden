{
  "name": "skye-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build --configLoader native",
    "cf:build": "npm run build && node scripts/cloudflare-assets.js",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "cf:smoke": "node scripts/cloudflare-smoke.js",
    "cf:relay-smoke": "node scripts/relay-smoke.js",
    "cf:deploy": "wrangler deploy",
    "start": "node server/index.js --production",
    "test": "node --test tests/*.test.js",
    "model:build": "node scripts/optimize-model.js",
    "model:validate": "node scripts/validate-model.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "esbuild": "0.28.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.2.0",
    "miniflare": "5.20260911.0-alpha",
    "three": "^0.180.0",
    "undici": "7.29.0",
    "vite": "^7.1.0",
    "wrangler": "^4.131.1"
  }
}
