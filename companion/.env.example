# Copy this file to .env. Never put a key in frontend code or chat messages.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=coral
# Optional: an already provisioned custom voice, with provider-required consent.
# Takes precedence over OPENAI_REALTIME_VOICE. Does not create/clone a voice.
OPENAI_CUSTOM_VOICE_ID=
PORT=3210
# Choose the shipped model: balanced or v48.
MODEL_DEFAULT=balanced
# local binds loopback. private requires HTTPS PUBLIC_ORIGIN and random ACCESS_CODE.
DEPLOYMENT_MODE=local
PUBLIC_ORIGIN=
ACCESS_CODE=
# Optional custom location; private defaults to data/realtime-leases.json.
SESSION_STORE_FILE=
# Default is adult testing. Do not enable child use until your organization
# has met the provider's under-18 requirements, including ZDR for under-13 data.
CHILD_USE_ENABLED=false
